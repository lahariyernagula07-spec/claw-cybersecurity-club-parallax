# Email address that receives Cyber Club contact form messages
CLUB_EMAIL=cyberclub@raghuenggcollege.in

# SMTP account used by the backend to send the message.
# For Gmail/Google Workspace, use an App Password rather than your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-email@example.com
SMTP_PASS=your-app-password
PORT=5000
